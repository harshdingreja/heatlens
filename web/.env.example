# URL of the HeatLens FastAPI backend (no trailing slash).
# Local: http://localhost:8000   Production: your Render URL, e.g. https://heatlens-api.onrender.com
VITE_API_URL=http://127.0.0.1:8000

# Optional: link to the GitHub repo, shown in the footer for the limitations section
VITE_REPO_URL=

# Leave false. "true" shows built-in SAMPLE data instead of calling the API (for UI work only).
VITE_USE_MOCK=false
