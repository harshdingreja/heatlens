# Copy this file to .env and fill in your own keys. .env is gitignored.
# Not needed until Phase 6 (LLM advisories).
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional overrides (defaults are set in code)
# default llama-3.3-70b-versatile
GROQ_MODEL=
# default gemini-3.8-flash
GEMINI_MODEL=

# Telegram alert bot (stretch goal)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HEATSHIELD_API_URL=http://localhost:8000

# API: extra allowed browser origins, comma-separated (e.g. your Vercel URL)
ALLOWED_ORIGINS=
